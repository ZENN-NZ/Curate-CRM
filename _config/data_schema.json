{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CurateContactSchema",
  "description": "JSON schema definition for Curate relationship and contact records",
  "type": "object",
  "required": [
    "firstName",
    "lastName",
    "dob",
    "residentialAddress",
    "postalCode",
    "mobileNumber",
    "emailAddress"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique auto-incrementing SQLite identifier"
    },
    "firstName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Primary contact first name"
    },
    "lastName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Primary contact last name"
    },
    "dob": {
      "type": "string",
      "description": "Date of birth (YYYY-MM-DD)"
    },
    "residentialAddress": {
      "type": "string",
      "minLength": 5,
      "maxLength": 255,
      "description": "Street / residential address"
    },
    "postalCode": {
      "type": "string",
      "minLength": 3,
      "maxLength": 20,
      "description": "Postal / ZIP code"
    },
    "mobileNumber": {
      "type": "string",
      "minLength": 5,
      "maxLength": 20,
      "description": "Primary contact mobile phone"
    },
    "emailAddress": {
      "type": "string",
      "format": "email",
      "maxLength": 255,
      "description": "Primary email address"
    },
    "companyName": {
      "type": ["string", "null"],
      "maxLength": 100,
      "description": "Associated organization or business name"
    },
    "partnerName": {
      "type": ["string", "null"],
      "maxLength": 100,
      "description": "Partner or spouse full name"
    },
    "partnerDob": {
      "type": ["string", "null"],
      "description": "Partner date of birth"
    },
    "partnerPhone": {
      "type": ["string", "null"],
      "maxLength": 20,
      "description": "Partner contact telephone number"
    },
    "partnerEmail": {
      "type": ["string", "null"],
      "format": "email",
      "maxLength": 255,
      "description": "Partner email address"
    },
    "createdAt": {
      "type": "string",
      "description": "Timestamp when record was created"
    }
  }
}
