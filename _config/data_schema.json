{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CurateContactSchema",
  "description": "JSON schema for Local-First Multi-Tenant Curate contact records",
  "type": "object",
  "required": [
    "id",
    "workspaceId",
    "firstName",
    "lastName",
    "dob",
    "residentialAddress",
    "postalCode",
    "mobileNumber",
    "emailAddress",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Client-generated UUID v4 primary key"
    },
    "workspaceId": {
      "type": "string",
      "description": "Multi-tenant workspace partition identifier"
    },
    "firstName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "lastName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "dob": {
      "type": "string",
      "description": "Date of birth (YYYY-MM-DD)"
    },
    "residentialAddress": {
      "type": "string",
      "minLength": 5,
      "maxLength": 255
    },
    "postalCode": {
      "type": "string",
      "minLength": 3,
      "maxLength": 20
    },
    "mobileNumber": {
      "type": "string",
      "minLength": 5,
      "maxLength": 20
    },
    "emailAddress": {
      "type": "string",
      "format": "email",
      "maxLength": 255
    },
    "companyName": {
      "type": ["string", "null"],
      "maxLength": 100
    },
    "partnerName": {
      "type": ["string", "null"],
      "maxLength": 100
    },
    "partnerDob": {
      "type": ["string", "null"]
    },
    "partnerPhone": {
      "type": ["string", "null"],
      "maxLength": 20
    },
    "partnerEmail": {
      "type": ["string", "null"],
      "format": "email",
      "maxLength": 255
    },
    "createdAt": {
      "type": "string",
      "description": "ISO timestamp of creation"
    },
    "updatedAt": {
      "type": "string",
      "description": "ISO timestamp of latest modification (used for LWW conflict resolution)"
    },
    "isDeleted": {
      "type": "boolean",
      "default": false,
      "description": "Tombstone flag for distributed deletion propagation"
    },
    "syncStatus": {
      "type": "string",
      "enum": ["synced", "pending"],
      "default": "pending",
      "description": "Local synchronization state with Supabase cloud"
    }
  }
}
